# Secrets and local configuration
/.env
/.env.*
!/.env.example
/config/master.key
/config/*.key

# Kamal secrets: only the example (variable references, no values) is tracked
/.kamal/secrets*
!/.kamal/secrets.example

# Logs, temp files, and build output
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep
/public/assets
.DS_Store

# Bundler
/.bundle
/vendor/bundle

# Copy to .env for local development (.env is git-ignored). Never commit real values.
# In production these are set as hosting secrets, not files.

# Shared demo login (required; login is refused while either is blank)
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me

# Rails session signing/encryption key. Required in production:
#   bin/rails secret
SECRET_KEY_BASE=

# AI provider: "typesafe" (TypeSafe Jev, needs TYPESAFE_API_KEY below) or "fake"
# (deterministic and offline, needs no key: set AI_PROVIDER=fake for local work
# without a key; it is also the default in development and test when this is unset).
# Production has no default.
AI_PROVIDER=typesafe

# Required when AI_PROVIDER=typesafe. Enter the real key only in your local .env
# or in hosting secrets, never here.
TYPESAFE_API_KEY=
# Model name from `bin/rails typesafe:models`. "jev-latest" is a moving alias;
# prefer pinning a concrete version (for example jev-1.13.0) for production.
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Limits (defaults shown)
AI_TIMEOUT_SECONDS=10
ANALYSES_PER_HOUR=8
FAILED_LOGINS_PER_15_MINUTES=10

# Production only: comma-separated allowed Host headers (leave unset locally)
# APP_HOSTS=lens.example.com

# Puma
RAILS_MAX_THREADS=2
PORT=3000

# Kamal secrets for Decision Lens.
#
# Copy this file to .kamal/secrets (git-ignored) before the live deployment. It holds NO
# values: every line is a reference that Kamal resolves from your shell environment when
# you run a bin/kamal command. Export the variables in the same terminal session (or
# resolve them from a password manager; see docs/kamal-digitalocean-deployment.md).
# Never write a real value into this example file.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
DEMO_USERNAME=$DEMO_USERNAME
DEMO_PASSWORD=$DEMO_PASSWORD
TYPESAFE_API_KEY=$TYPESAFE_API_KEY
